[
  {
    "kernelSource": {
      "name": "alioth-nethunter-KPM",
      "repo": "https://github.com/FunnyDragon2010/kernel_xiaomi_sm8250_KPM",
      "branch": "base",
      "device": "alioth",
      "defconfig": "nethunter_defconfig_alioth"
    },
    "withKernelSU": true,
    "toolchains": [
      {
        "repo": "https://github.com/Neutron-Toolchains/clang",
        "branch": "main",
        "name": "neutron-clang",
        "binPath": ["bin"]
      }
    ],
    "ccache": false,
    "params": {
      "ARCH": "arm64",
      "CC": "neutron-clang/bin/clang",
      "LLVM": "1",
      "LLVM_IAS": "1",
      "externalCommand": {
        "CROSS_COMPILE": "neutron-clang/bin/aarch64-linux-gnu-",
        "CROSS_COMPILE_ARM32": "neutron-clang/bin/arm-linux-gnueabi-",
        "LD": "neutron-clang/bin/ld.lld",
        "AR": "neutron-clang/bin/llvm-ar",
        "NM": "neutron-clang/bin/llvm-nm",
        "OBJCOPY": "neutron-clang/bin/llvm-objcopy",
        "OBJDUMP": "neutron-clang/bin/llvm-objdump",
        "READELF": "neutron-clang/bin/llvm-readelf",
        "STRIP": "neutron-clang/bin/llvm-strip",
        "HOSTCC": "gcc",
        "HOSTLD": "ld"
      }
    },
    "AnyKernel3": {
      "use": true,
      "release": true,
      "repo": "https://github.com/osm0sis/AnyKernel3",
      "branch": "master"
    }
  }
]
